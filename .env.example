# ==========================================
# Schoolify Backend - Environment Variables
# ==========================================

# NestJS Server Port
PORT=3005

# Environment (development | production)
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3050"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/schoolify_db?schema=public"

# JWT & Security
JWT_SECRET="your_jwt_super_secret_key_change_in_production"
JWT_EXPIRATION="7d"

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# PayOS Payment Gateway Credentials
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"

# AI & Semantic Embedding Settings (Optional)
USE_ONNX_EMBEDDING=false

# Supabase (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""
