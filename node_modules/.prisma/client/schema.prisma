datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
}

enum CustomRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ClassStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum MaterialType {
  IMG
  DOCX
  EXCEL
}

enum ItemStatus {
  ACTIVE
  SOLDOUT
}

enum TransactionType {
  PAYMENT_TO_ADMIN
  COMMISSION_FEE
  TEACHER_INCOME
}

enum OrderReferenceType {
  SUBSCRIPTION
  COURSE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
  UPGRADED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// ----------------------------------------------------
// CORE & USER MODELS
// ----------------------------------------------------

model User {
  id            String    @id @default(uuid())
  role          Role      @default(STUDENT)
  fullname      String
  avatar_url    String?
  email         String    @unique
  phone         String?
  password_hash String
  status        Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  teacher_profile         TeacherProfile?
  student_profile         StudentProfile?
  custom_feature_requests CustomFeatureRequest[]
  notifications           Notification[]
  orders                  Order[]
  schools                 School[]
  created_packages        SubscriptionPackage[]
  question_banks          QuestionBank[]
  classes                 Class[]
  store_items             StoreItem[]

  @@map("users")
}

model TeacherProfile {
  id               String  @id @default(uuid())
  user_id          String  @unique
  bio              String?
  expertise        String?
  experience_years Int?

  user          User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  courses       Course[]
  subscriptions TeacherSubscription[]
  store_items   StoreItem[]
  class_courses ClassCourse[]

  @@map("teacher_profile")
}

model StudentProfile {
  id                  String    @id @default(uuid())
  user_id             String    @unique
  date_of_birth       DateTime?
  grade_level         String?
  parent_phone        String?
  points              Int       @default(0)
  parent_access_codes String?

  user        User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments ClassEnrollment[]
  inventory   StudentInventory[]

  @@map("student_profile")
}

model CustomFeatureRequest {
  id              String              @id @default(uuid())
  user_id         String
  request_content String
  phone           String?
  contact_info    String?
  status          CustomRequestStatus @default(PENDING)
  created_at      DateTime            @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("custom_feature_requests")
}

// ----------------------------------------------------
// SCHOOLS & SUBSCRIPTIONS
// ----------------------------------------------------

model School {
  id         String       @id @default(uuid())
  owner_id   String?
  name       String
  code       String       @unique
  address    String?
  phone      String?
  email      String?
  status     SchoolStatus @default(ACTIVE)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  owner          User?          @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  question_banks QuestionBank[]

  @@map("schools")
}

model SubscriptionPackage {
  id                     String   @id @default(uuid())
  creator_id             String?
  name                   String
  price                  Decimal  @db.Decimal(10, 2)
  max_classes            Int      @default(0)
  max_students_per_class Int      @default(0)
  can_sell_courses       Boolean  @default(false)
  is_active              Boolean  @default(true)
  features               Json?
  custom_features        Json?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  creator               User?                 @relation(fields: [creator_id], references: [id], onDelete: SetNull)
  teacher_subscriptions TeacherSubscription[]
  orders                Order[]

  @@map("subscription_packages")
}

model TeacherSubscription {
  id                String             @id @default(uuid())
  teacher_id        String
  package_id        String
  features_snapshot Json?
  start_date        DateTime
  end_date          DateTime
  status            SubscriptionStatus @default(ACTIVE)
  created_at        DateTime           @default(now())

  teacher TeacherProfile      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  package SubscriptionPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@map("teacher_subscriptions")
}

// ----------------------------------------------------
// COURSES, LESSONS & CATEGORIES
// ----------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  parent_id  String?
  status     String?  @default("ACTIVE")
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent   Category?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  courses  Course[]

  @@map("categories")
}

model Course {
  id             String       @id @default(uuid())
  subject_id     String?
  owner_id       String
  title          String
  description    String?
  price          Decimal      @default(0.00) @db.Decimal(10, 2)
  is_marketplace Boolean      @default(false)
  status         CourseStatus @default(DRAFT)
  published_at   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  category      Category?      @relation(fields: [subject_id], references: [id], onDelete: SetNull)
  teacher       TeacherProfile @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  lessons       Lesson[]
  class_courses ClassCourse[]
  orders        Order[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid())
  course_id   String
  title       String
  content     String?
  video_url   String?
  order_index Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course    Course           @relation(fields: [course_id], references: [id], onDelete: Cascade)
  materials LessonMaterial[]
  questions Question[]

  @@map("lessons")
}

model LessonMaterial {
  id            String       @id @default(uuid())
  lesson_id     String
  material_type MaterialType
  url           String
  content_data  String?
  order_index   Int          @default(0)

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("lesson_materials")
}

// ----------------------------------------------------
// CLASSES & ENROLLMENTS
// ----------------------------------------------------

model Class {
  id         String      @id @default(uuid())
  user_id    String?
  course_id  String?
  class_name String
  status     ClassStatus @default(DRAFT)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  user          User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  enrollments   ClassEnrollment[]
  class_courses ClassCourse[]

  @@map("classes")
}

model ClassEnrollment {
  id          String   @id @default(uuid())
  class_id    String
  student_id  String
  joined_date DateTime @default(now())

  class   Class          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@map("class_enrollments")
}

model ClassCourse {
  id         String  @id @default(uuid())
  teacher_id String?
  course_id  String
  class_id   String

  teacher TeacherProfile? @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  course  Course          @relation(fields: [course_id], references: [id], onDelete: Cascade)
  class   Class           @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@map("class_courses")
}

// ----------------------------------------------------
// QUESTIONS & EXAMS
// ----------------------------------------------------

model QuestionBank {
  id         String   @id @default(uuid())
  title      String
  owner_id   String?
  school_id  String?
  is_premium Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner     User?      @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  school    School?    @relation(fields: [school_id], references: [id], onDelete: SetNull)
  questions Question[]

  @@map("question_banks")
}

model Question {
  id         String   @id @default(uuid())
  bank_id    String?
  lesson_id  String?
  type       String?
  title      String?
  question   String
  answer     String?
  created_at DateTime @default(now())

  bank    QuestionBank? @relation(fields: [bank_id], references: [id], onDelete: SetNull)
  lesson  Lesson?       @relation(fields: [lesson_id], references: [id], onDelete: SetNull)
  answers Answer[]

  @@map("questions")
}

model Answer {
  id          String  @id @default(uuid())
  question_id String
  content     String
  explain     String?
  img_url     String?
  is_answer   Boolean @default(false)

  question Question @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("answers")
}

// ----------------------------------------------------
// GAMIFICATION / STORE ITEMS & INVENTORY
// ----------------------------------------------------

model StoreItem {
  id          String     @id @default(uuid())
  teacher_id  String?
  user_id     String?
  type        String?
  name        String
  description String?
  points      Int        @default(0)
  stock       Int        @default(0)
  image_url   String?
  status      ItemStatus @default(ACTIVE)
  expired     DateTime?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  teacher   TeacherProfile?    @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  user      User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  inventory StudentInventory[]

  @@map("store_items")
}

model StudentInventory {
  id         String   @id @default(uuid())
  student_id String
  item_id    String
  type       String?
  points     Int      @default(0)
  buy_at     DateTime @default(now())
  active     Boolean  @default(true)

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  item    StoreItem      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@map("student_inventory")
}

// ----------------------------------------------------
// ORDERS & TRANSACTIONS
// ----------------------------------------------------

model Order {
  id                  String             @id @default(uuid())
  user_id             String
  reference_type      OrderReferenceType
  subscription_id     String?
  course_id           String?
  item_name_snapshot  Json?
  item_price_snapshot Decimal            @db.Decimal(10, 2)
  status              OrderStatus        @default(PENDING)
  payment_method      PaymentMethod      @default(BANK)
  seller_id           String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user         User                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subscription SubscriptionPackage? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  course       Course?              @relation(fields: [course_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@map("orders")
}

model Transaction {
  id               String          @id @default(uuid())
  order_id         String?
  transaction_type TransactionType
  amount           Decimal         @db.Decimal(10, 2)
  recipient_id     String?
  created_at       DateTime        @default(now())

  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// ----------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("notifications")
}
