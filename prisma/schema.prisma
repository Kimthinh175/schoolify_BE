model StudentRoadmapStep {
  id                       String    @id @default(uuid())
  student_id               String
  subject                  String    @db.VarChar(64)
  grade                    Int       @default(12)
  phase                    Int       @default(1) // 1: Vá lỗ hổng (<50%), 2: Củng cố (50-74%), 3: Bứt phá VDC (>=75% / Mở khóa)
  step_order               Int       @default(1)
  chapter_id               Int       @default(1)
  chapter_name             String?   @db.VarChar(255)
  topic_tag                String    @db.VarChar(255)
  title                    String    @db.VarChar(255)
  diagnostic_reason        String    @db.Text
  recommended_level        String    @default("BASIC") @db.VarChar(32)      // BASIC | MEDIUM | ADVANCED
  recommended_bloom        String    @default("THONG_HIEU") @db.VarChar(32) // NHAN_BIET | THONG_HIEU | VAN_DUNG | VAN_DUNG_CAO
  question_count           Int       @default(10)
  duration_minutes         Int       @default(15)
  current_mastery          Float     @default(0)
  target_mastery           Float     @default(75)
  attempted_count          Int       @default(0)
  correct_count            Int       @default(0)
  top_trap_tag             String?   @db.VarChar(255)
  special_behavior_tag     String?   @db.VarChar(64)
  learning_spirit_tag      String?   @db.VarChar(64)
  learning_spirit_label    String?   @db.VarChar(255)
  learning_spirit_score    Float?
  intelligence_tag         String?   @db.VarChar(64)
  intelligence_label       String?   @db.VarChar(255)
  intelligence_score       Float?
  behavior_adaptation_note String?   @db.Text
  status                   String    @default("RECOMMENDED") @db.VarChar(32) // RECOMMENDED | IN_PROGRESS | COMPLETED | LOCKED
  completed_at             DateTime?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, subject, grade, topic_tag])
  @@index([student_id, subject, grade, phase, step_order])
  @@map("student_roadmap_steps")
}

model StudentBehaviorHistory {
  id                      String   @id @default(uuid())
  student_id              String
  submission_id           String?
  attempt_token           String?  @db.VarChar(64)
  subject                 String   @db.VarChar(64)
  grade                   Int      @default(12)
  chapter_id              Int      @default(1)
  chapter_name            String?  @db.VarChar(255)
  topic_tag               String   @db.VarChar(255)
  source_question_id      String?  @db.VarChar(128)
  source_question_title   String?  @db.VarChar(255)
  bloom_level             String   @default("THONG_HIEU") @db.VarChar(32)
  trap_tag                String?  @db.VarChar(255)
  special_tag             String   @default("#LUYEN_LAI_3_LAN_CUNG_DANG") @db.VarChar(64)
  is_scored               Boolean  @default(false)
  total_turns             Int      @default(3)
  completed_turns         Int      @default(0)
  skipped_turns           Int      @default(0)
  correct_turns           Int      @default(0)
  wrong_turns             Int      @default(0)
  used_ai_example         Boolean  @default(false)
  total_time_seconds      Int      @default(0)
  turn_outcomes           Json?    // Array<{ turn: number; status: 'CORRECT'|'WRONG'|'SKIPPED'; selectedAnswer?: string; correctAnswer?: string; timeSpentSeconds: number }>
  learning_spirit_tag     String   @db.VarChar(64)  // HIGH_GRIT_PERSISTENT | MODERATE_INITIATIVE | LOW_PATIENCE_PARTIAL_SKIP | AVOIDANCE_SKIPPED
  learning_spirit_label   String   @db.VarChar(255)
  learning_spirit_score   Float    @default(50)     // 0..100
  intelligence_tag        String   @db.VarChar(64)  // FAST_ISOMORPHIC_TRANSFER | RAPID_SELF_CORRECTION | DEVELOPING_PATTERN_LOGIC | NEEDS_STEP_BY_STEP_SCAFFOLDING
  intelligence_label      String   @db.VarChar(255)
  intelligence_score      Float    @default(50)     // 0..100
  roadmap_strategy_tag    String?  @db.VarChar(64)  // ACCELERATE_ADVANCED | MICRO_SPRINT_ANTI_BOREDOM | SCAFFOLD_STEP_BY_STEP | WARMUP_LOW_FRICTION
  roadmap_adaptation_note String?  @db.Text
  created_at              DateTime @default(now())

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, subject, grade, created_at])
  @@index([student_id, topic_tag])
  @@index([special_tag])
  @@map("student_behavior_histories")
}

/// Nhật ký lượt truy cập website & sự kiện điều hướng (Real-time Web Traffic & Page Views)
model WebVisitLog {
  id                String   @id @default(uuid()) @db.Uuid
  path              String   @db.VarChar(255)
  page_title        String?  @db.VarChar(255)
  user_id           String?  @db.VarChar(128)
  user_role         String?  @default("GUEST") @db.VarChar(32)
  session_id        String?  @db.VarChar(128)
  device_type       String?  @default("DESKTOP") @db.VarChar(32)
  os_name           String?  @db.VarChar(64)
  browser_name      String?  @db.VarChar(64)
  device_model      String?  @db.VarChar(128)
  screen_resolution String?  @db.VarChar(32)
  ip_address        String?  @db.VarChar(64)
  country_code      String?  @db.VarChar(8)
  country_name      String?  @db.VarChar(64)
  region_name       String?  @db.VarChar(128)
  city_name         String?  @db.VarChar(128)
  isp_name          String?  @db.VarChar(128)
  timezone          String?  @db.VarChar(64)
  language          String?  @db.VarChar(32)
  referrer          String?  @db.VarChar(512)
  user_agent        String?  @db.Text
  created_at        DateTime @default(now())

  @@index([path, created_at(sort: Desc)])
  @@index([session_id])
  @@index([user_id])
  @@index([country_code, city_name])
  @@index([created_at(sort: Desc)])
  @@map("web_visit_logs")
}

/// Tiến độ chinh phục từng Chương theo lộ trình kiểu Duolingo (3 cấp độ: Cơ bản, Trung bình, Nâng cao)
model StudentChapterProgress {
  id                  String   @id @default(uuid())
  student_id          String
  subject             String   @db.VarChar(64)                // 'toan-hoc' | 'tin-hoc'
  grade               Int      @default(12)                   // 10 | 11 | 12
  track               String   @default("DEFAULT") @db.VarChar(32) // 'TOAN_SO' | 'TOAN_HINH' | 'DEFAULT'
  chapter_id          Int
  basic_completed     Boolean  @default(false)
  basic_best_score    Float    @default(0)
  medium_completed    Boolean  @default(false)
  medium_best_score   Float    @default(0)
  advanced_completed         Boolean  @default(false)
  advanced_best_score        Float    @default(0)
  unlocked_manually          Boolean  @default(false)                // Tương thích ngược (Cơ bản)
  basic_unlocked_manually    Boolean  @default(false)                // Nhảy cóc chương ở lộ trình Cơ bản
  medium_unlocked_manually   Boolean  @default(false)                // Nhảy cóc chương ở lộ trình Trung bình
  advanced_unlocked_manually Boolean  @default(false)                // Nhảy cóc chương ở lộ trình Nâng cao
  crowns_earned              Int      @default(0)                    // 0..3 sao
  attempts_count             Int      @default(0)
  last_practiced_at          DateTime @default(now())
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, subject, grade, chapter_id])
  @@index([student_id, subject, grade, track])
  @@map("student_chapter_progress")
}

/// Kết quả kiểm tra đánh giá năng lực đầu vào theo từng Môn học & Khối lớp
model StudentSubjectDiagnostic {
  id              String   @id @default(uuid())
  student_id      String
  subject         String   @db.VarChar(64)
  grade           Int      @default(12)
  assigned_level  String   @default("BASIC") @db.VarChar(32)
  overall_score   Float    @default(0)
  track_scores    Json?
  bloom_breakdown Json?
  submission_id   String?
  completed_at    DateTime @default(now())
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, subject, grade])
  @@index([student_id, subject, grade])
  @@map("student_subject_diagnostics")
}

model QuestionBugReport {
  id               String                  @id @default(uuid())
  question_id      String                  @db.VarChar(255)
  question_title   String                  @db.VarChar(500)
  subject_name     String                  @default("Toán Học") @db.VarChar(120)
  question_snippet String?                 @db.Text
  issue_type       QuestionIssueType       @default(OTHER)
  issue_type_label String?                 @db.VarChar(255)
  description      String                  @db.Text
  reporter_id      String?
  reporter_name    String                  @default("Học sinh luyện thi") @db.VarChar(255)
  status           QuestionBugReportStatus @default(PENDING)
  admin_note       String?                 @db.Text
  resolved_by_id   String?
  resolved_at      DateTime?
  created_at       DateTime                @default(now())
  updated_at       DateTime                @updatedAt

  reporter    User? @relation("QuestionReportReporter", fields: [reporter_id], references: [id], onDelete: SetNull)
  resolved_by User? @relation("QuestionReportResolver", fields: [resolved_by_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([question_id])
  @@index([reporter_id])
  @@map("question_bug_reports")
}

/// Con trỏ chu kỳ sinh đề ứng biến (Multi-Epoch LCG Stride) cho từng học sinh & bể câu hỏi (>100,000 users)
model StudentPoolCursor {
  id                String   @id @default(uuid())
  student_id        String
  pool_key          String   @db.VarChar(180)
  cursor_pos        Int      @default(0)
  epoch             Int      @default(0)
  last_boundary_ids Json?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([student_id, pool_key])
  @@index([student_id])
  @@map("student_pool_cursors")
}

// FORUM / COMMUNITY DISCUSSION & MODERATION
// ----------------------------------------------------

model ForumPost {
  id                  String          @id @default(uuid())
  author_id           String
  school_id           String?
  category_id         String?
  title               String          @db.VarChar(500)
  slug                String?         @unique @db.VarChar(550)
  content             String          @db.Text // Nội dung gốc Markdown + LaTeX ($...$ inline, $$...$$ block)
  content_format      String          @default("MARKDOWN_LATEX") @db.VarChar(30) // MARKDOWN_LATEX | PLAIN_TEXT | HTML
  content_plain       String?         @db.Text // Bản text đã lược bỏ công thức -> phục vụ tìm kiếm / preview / SEO
  has_math            Boolean         @default(false) // true nếu content chứa công thức LaTeX -> FE bật KaTeX/MathJax
  subject             String?         @db.VarChar(120) // e.g. "Toán Học", "Vật Lý", "toan-hoc"...
  grade               Int?            @default(12) // Khối 10, 11, 12
  chapter_id          Int? // Chương SGK (đồng bộ với Question.chapter_id)
  chapter_name        String?         @db.VarChar(255) // Tên chương snapshot: "Chương 1: Ứng dụng đạo hàm..."
  tags                Json? // Mảng nhãn chủ đề: ["Đạo hàm", "Đơn điệu", "Lớp 12"]
  thumbnail_url       String?         @db.Text
  attachments         Json? // Mảng URL ảnh đề bài / tài liệu đính kèm
  views_count         Int             @default(0)
  likes_count         Int             @default(0)
  comments_count      Int             @default(0)
  bookmarks_count     Int             @default(0) // Số lượt lưu bài (ForumBookmark)
  is_solved           Boolean         @default(false)
  is_pinned           Boolean         @default(false)
  is_locked           Boolean         @default(false)
  accepted_comment_id String?
  status              ForumPostStatus @default(PUBLISHED)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt

  author    User            @relation("ForumPostAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  school    School?         @relation(fields: [school_id], references: [id], onDelete: SetNull)
  category  Category?       @relation(fields: [category_id], references: [id], onDelete: SetNull)
  comments  ForumComment[]
  reactions ForumReaction[]
  reports   ForumReport[]
  bookmarks ForumBookmark[]

  @@index([author_id])
  @@index([school_id])
  @@index([category_id])
  @@index([subject, grade])
  @@index([subject, grade, chapter_id])
  @@index([status, is_pinned, created_at])
  @@index([is_solved])
  @@map("forum_posts")
}

model ForumComment {
  id               String             @id @default(uuid())
  post_id          String
  author_id        String
  parent_id        String? // null = Bình luận gốc (Cấp 1); khác null = Trả lời lồng (Cấp 2)
  reply_to_user_id String? // Người dùng được phản hồi trực tiếp (@mention) trong chuỗi cấp 2
  depth            Int                @default(1) // 1: Cấp 1 (Root comment), 2: Cấp 2 (Nested reply - tối đa 2 cấp)
  content          String             @db.Text // Nội dung thảo luận / lời giải (hỗ trợ LaTeX)
  attachments      Json? // Ảnh chụp bài giải hoặc file đính kèm
  likes_count      Int                @default(0)
  replies_count    Int                @default(0) // Số lượng phản hồi cấp 2 của bình luận gốc
  is_accepted      Boolean            @default(false) // Đánh dấu câu trả lời đúng / lời giải hay nhất (Best Answer)
  is_edited        Boolean            @default(false)
  status           ForumCommentStatus @default(ACTIVE)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  post          ForumPost       @relation(fields: [post_id], references: [id], onDelete: Cascade)
  author        User            @relation("ForumCommentAuthor", fields: [author_id], references: [id], onDelete: Cascade)
  reply_to_user User?           @relation("ForumCommentReplyToUser", fields: [reply_to_user_id], references: [id], onDelete: SetNull)
  parent        ForumComment?   @relation("ForumCommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies       ForumComment[]  @relation("ForumCommentReplies")
  reactions     ForumReaction[]
  reports       ForumReport[]

  @@index([post_id, parent_id, created_at])
  @@index([parent_id])
  @@index([author_id])
  @@index([reply_to_user_id])
  @@index([status])
  @@map("forum_comments")
}

model ForumReaction {
  id            String            @id @default(uuid())
  user_id       String
  target_type   ForumTargetType   @default(POST) // POST | COMMENT
  post_id       String?
  comment_id    String?
  reaction_type ForumReactionType @default(LIKE) // LIKE | UPVOTE | DOWNVOTE | HELPFUL | LOVE | HAHA
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post    ForumPost?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment ForumComment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id])
  @@unique([user_id, comment_id])
  @@index([post_id, reaction_type])
  @@index([comment_id, reaction_type])
  @@index([user_id])
  @@map("forum_reactions")
}

model ForumReport {
  id                String            @id @default(uuid())
  reporter_id       String
  target_type       ForumTargetType   @default(POST) // POST | COMMENT
  post_id           String?
  comment_id        String?
  reason            ForumReportReason @default(OTHER)
  description       String?           @db.Text
  evidence_urls     Json? // Mảng URL ảnh chụp bằng chứng vi phạm
  status            ForumReportStatus @default(PENDING)
  resolved_by_id    String?
  admin_note        String?           @db.Text
  moderation_action String?           @db.VarChar(100) // NONE | HIDE_CONTENT | DELETE_CONTENT | WARN_USER | BAN_USER
  resolved_at       DateTime?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  reporter    User          @relation("ForumReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  resolved_by User?         @relation("ForumReportResolver", fields: [resolved_by_id], references: [id], onDelete: SetNull)
  post        ForumPost?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment     ForumComment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([target_type, status])
  @@index([post_id])
  @@index([comment_id])
  @@index([reporter_id])
  @@index([resolved_by_id])
  @@map("forum_reports")
}

model ForumBookmark {
  id         String   @id @default(uuid())
  user_id    String
  post_id    String
  note       String?  @db.Text // Ghi chú cá nhân khi lưu bài (VD: "Ôn lại dạng này trước thi")
  created_at DateTime @default(now())

  user User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  post ForumPost @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@unique([user_id, post_id]) // Mỗi user chỉ lưu 1 bài viết 1 lần (toggle bookmark)
  @@index([user_id, created_at]) // Lấy danh sách "Bài đã lưu" theo thời gian
  @@index([post_id])
  @@map("forum_bookmarks")
}
