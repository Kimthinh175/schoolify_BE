datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum SystemRole {
  SUPER_ADMIN
  USER
}

enum SchoolRole {
  PRINCIPAL
  VICE_PRINCIPAL
  HEAD_OF_DEPARTMENT
  TEACHER
  STUDENT
  PARENT
  STAFF
}

enum CustomRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum ClassStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
}

enum MaterialType {
  IMG
  DOCX
  EXCEL
}

enum ItemStatus {
  ACTIVE
  SOLDOUT
}

enum TransactionType {
  PAYMENT_TO_ADMIN
  COMMISSION_FEE
  TEACHER_INCOME
}

enum OrderReferenceType {
  SUBSCRIPTION
  COURSE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum PaymentMethod {
  COD
  BANK
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
  UPGRADED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  ESSAY
  TRUE_FALSE
}

enum QuestionFormat {
  SINGLE_CHOICE  // Trắc nghiệm 4 chọn 1 (0.25đ/câu)
  MULTI_CHOICE   // Chọn nhiều đáp án đúng
  TRUE_FALSE     // Đúng/Sai 4 ý con a, b, c, d
  SHORT_ANSWER   // Điền số / Trả lời ngắn
  ESSAY          // Deprecated (đã gỡ bỏ module tự luận)
}

enum BloomLevel {
  NHAN_BIET // Nhận biết (Easy)
  THONG_HIEU // Thông hiểu (Medium)
  VAN_DUNG // Vận dụng (Hard)
  VAN_DUNG_CAO // Vận dụng cao (Very Hard)
}

enum StoreItemType {
  VOUCHER
  BADGE
  THEME
  OTHER
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADED
  RETURNED
}

enum QuestionIssueType {
  WRONG_ANSWER
  KATEX_ERROR
  TYPO_CONTENT
  MATRIX_MISMATCH
  OTHER
}

enum QuestionBugReportStatus {
  PENDING
  RESOLVED
}

enum ForumPostStatus {
  DRAFT
  PENDING
  PUBLISHED
  HIDDEN
  REJECTED
  DELETED
}

enum ForumCommentStatus {
  ACTIVE
  HIDDEN
  FLAGGED
  DELETED
}

enum ForumTargetType {
  POST
  COMMENT
}

enum ForumReactionType {
  LIKE
  UPVOTE
  DOWNVOTE
  HELPFUL
  LOVE
  HAHA
}

enum ForumReportReason {
  SPAM
  INAPPROPRIATE
  HARASSMENT
  COPYRIGHT
  WRONG_SUBJECT
  OFFENSIVE_LANGUAGE
  MISINFORMATION
  OTHER
}

enum ForumReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

// ----------------------------------------------------
// CORE & USER MODELS
// ----------------------------------------------------

model User {
  id            String     @id @default(uuid())
  role          SystemRole @default(USER)
  fullname      String
  avatar_url    String?
  email         String     @unique
  google_id     String?
  phone         String?
  password_hash String
  status        Boolean    @default(true)
  last_login_at DateTime?
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  school_memberships         SchoolMember[]
  teacher_profile            TeacherProfile?
  student_profile            StudentProfile?
  parent_profile             ParentProfile?
  custom_feature_requests    CustomFeatureRequest[]
  notifications              Notification[]
  orders_purchased           Order[]                @relation("OrderBuyer")
  orders_sold                Order[]                @relation("OrderSeller")
  schools_owned              School[]               @relation("SchoolOwner")
  created_packages           SubscriptionPackage[]
  question_banks             QuestionBank[]
  store_items                StoreItem[]
  question_reports_submitted QuestionBugReport[]   @relation("QuestionReportReporter")
  question_reports_resolved  QuestionBugReport[]   @relation("QuestionReportResolver")
  forum_posts             ForumPost[]            @relation("ForumPostAuthor")
  forum_comments          ForumComment[]         @relation("ForumCommentAuthor")
  forum_replies_received  ForumComment[]         @relation("ForumCommentReplyToUser")
  forum_reactions         ForumReaction[]
  forum_reports_submitted ForumReport[]          @relation("ForumReportReporter")
  forum_reports_resolved  ForumReport[]          @relation("ForumReportResolver")
  forum_bookmarks         ForumBookmark[]

  @@index([google_id])
  @@map("users")
}

model SchoolMember {
  id        String     @id @default(uuid())
  user_id   String
  school_id String
  role      SchoolRole @default(STUDENT)
  joined_at DateTime   @default(now())

  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  school School @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@unique([user_id, school_id])
  @@index([user_id])
  @@index([school_id])
  @@map("school_members")
}

model TeacherProfile {
  id               String  @id @default(uuid())
  user_id          String  @unique
  department_id    String?
  bio              String?
  expertise        String?
  experience_years Int?

  user               User                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  department         Department?           @relation("DepartmentTeachers", fields: [department_id], references: [id], onDelete: SetNull)
  departments_headed Department[]          @relation("DepartmentHead")
  courses            Course[]
  subscriptions      TeacherSubscription[]
  store_items        StoreItem[]
  class_courses      ClassCourse[]
  classes_managed    Class[]
  sessions_taught    ClassSession[]

  @@map("teacher_profile")
}

model StudentProfile {
  id                    String    @id @default(uuid())
  user_id               String    @unique
  date_of_birth         DateTime?
  grade_level           String?
  points                Float     @default(0)
  exam_points           Int       @default(9)
  last_daily_grant_date String?   @db.VarChar(20)
  active_package        String?   @default("FREE")
  package_expires_at    DateTime?

  user            User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  enrollments     ClassEnrollment[]
  inventory       StudentInventory[]
  parent_students ParentStudent[]
  submissions     ExamSubmission[]
  progress        StudentProgress[]
  exam_point_logs    ExamPointLog[]
  topic_masteries    StudentTopicMastery[]
  roadmap_steps      StudentRoadmapStep[]
  behavior_histories StudentBehaviorHistory[]
  chapter_progress    StudentChapterProgress[]
  pool_cursors        StudentPoolCursor[]
  subject_diagnostics StudentSubjectDiagnostic[]

  @@map("student_profile")
}

model ParentProfile {
  id        String  @id @default(uuid())
  user_id   String  @unique
  job_title String?
  address   String?

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent_students ParentStudent[]

  @@map("parent_profile")
}

model ParentStudent {
  id                String   @id @default(uuid())
  parent_id         String
  student_id        String
  relationship_type String?  @default("PARENT")
  created_at        DateTime @default(now())

  parent  ParentProfile  @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([parent_id, student_id])
  @@index([parent_id])
  @@index([student_id])
  @@map("parent_students")
}

model CustomFeatureRequest {
  id              String              @id @default(uuid())
  user_id         String
  request_content String
  phone           String?
  contact_info    String?
  status          CustomRequestStatus @default(PENDING)
  created_at      DateTime            @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([status])
  @@map("custom_feature_requests")
}

// ----------------------------------------------------
// SCHOOLS & SUBSCRIPTIONS (SAAS B2B)
// ----------------------------------------------------

model School {
  id         String       @id @default(uuid())
  owner_id   String?
  name       String
  code       String       @unique
  address    String?
  phone      String?
  email      String?
  status     SchoolStatus @default(ACTIVE)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  owner          User?                @relation("SchoolOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  members        SchoolMember[]
  departments    Department[]
  classes        Class[]
  courses        Course[]
  question_banks QuestionBank[]
  subscriptions  SchoolSubscription[]
  forum_posts    ForumPost[]

  @@index([owner_id])
  @@map("schools")
}

model Department {
  id              String   @id @default(uuid())
  school_id       String
  name            String
  head_teacher_id String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  school       School           @relation(fields: [school_id], references: [id], onDelete: Cascade)
  head_teacher TeacherProfile?  @relation("DepartmentHead", fields: [head_teacher_id], references: [id], onDelete: SetNull)
  teachers     TeacherProfile[] @relation("DepartmentTeachers")
  courses      Course[]

  @@index([school_id])
  @@index([head_teacher_id])
  @@map("departments")
}

model SubscriptionPackage {
  id                     String       @id @default(uuid())
  creator_id             String?
  name                   String
  description            String?
  price                  Decimal      @db.Decimal(10, 2)
  billing_cycle          BillingCycle @default(MONTHLY)
  duration_days          Int?
  max_teachers           Int          @default(0)
  max_students_total     Int          @default(0)
  max_classes            Int          @default(0)
  max_students_per_class Int          @default(0)
  storage_limit_gb       Int          @default(0)
  can_sell_courses       Boolean      @default(false)
  is_active              Boolean      @default(true)
  features               Json?
  custom_features        Json?
  created_at             DateTime     @default(now())
  updated_at             DateTime     @updatedAt

  creator               User?                 @relation(fields: [creator_id], references: [id], onDelete: SetNull)
  teacher_subscriptions TeacherSubscription[]
  school_subscriptions  SchoolSubscription[]
  orders                Order[]

  @@map("subscription_packages")
}

model SchoolSubscription {
  id                String             @id @default(uuid())
  school_id         String
  package_id        String
  features_snapshot Json?
  start_date        DateTime
  end_date          DateTime
  status            SubscriptionStatus @default(ACTIVE)
  created_at        DateTime           @default(now())

  school  School              @relation(fields: [school_id], references: [id], onDelete: Cascade)
  package SubscriptionPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([school_id])
  @@index([package_id])
  @@map("school_subscriptions")
}

model TeacherSubscription {
  id                String             @id @default(uuid())
  teacher_id        String
  package_id        String
  features_snapshot Json?
  start_date        DateTime
  end_date          DateTime
  status            SubscriptionStatus @default(ACTIVE)
  created_at        DateTime           @default(now())

  teacher TeacherProfile      @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  package SubscriptionPackage @relation(fields: [package_id], references: [id], onDelete: Cascade)

  @@index([teacher_id])
  @@index([package_id])
  @@map("teacher_subscriptions")
}

// ----------------------------------------------------
// COURSES, LESSONS & CATEGORIES
// ----------------------------------------------------

model Category {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  parent_id  String?
  status     String?  @default("ACTIVE")
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  parent      Category?   @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: SetNull)
  children    Category[]  @relation("CategoryHierarchy")
  courses     Course[]
  forum_posts ForumPost[]

  @@index([parent_id])
  @@map("categories")
}

model Course {
  id             String       @id @default(uuid())
  school_id      String?
  department_id  String?
  subject_id     String?
  owner_id       String
  title          String
  description    String?
  price          Decimal      @default(0.00) @db.Decimal(10, 2)
  is_marketplace Boolean      @default(false)
  status         CourseStatus @default(DRAFT)
  published_at   DateTime?
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  school           School?           @relation(fields: [school_id], references: [id], onDelete: SetNull)
  department       Department?       @relation(fields: [department_id], references: [id], onDelete: SetNull)
  category         Category?         @relation(fields: [subject_id], references: [id], onDelete: SetNull)
  teacher          TeacherProfile    @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  class_courses    ClassCourse[]
  orders           Order[]
  student_progress StudentProgress[]

  @@index([school_id])
  @@index([department_id])
  @@index([owner_id])
  @@index([subject_id])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(uuid())
  course_id   String
  title       String
  content     String?
  video_url   String?
  order_index Int      @default(0)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course           Course            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  materials        LessonMaterial[]
  questions        Question[]
  exam_submissions ExamSubmission[]
  student_progress StudentProgress[]

  @@index([course_id])
  @@map("lessons")
}

model LessonMaterial {
  id            String       @id @default(uuid())
  lesson_id     String
  material_type MaterialType
  url           String
  content_data  String?
  order_index   Int          @default(0)

  lesson Lesson @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([lesson_id])
  @@map("lesson_materials")
}

// ----------------------------------------------------
// CLASSES & ENROLLMENTS & TIMETABLE
// ----------------------------------------------------

model Class {
  id         String      @id @default(uuid())
  school_id  String?
  teacher_id String?
  course_id  String?
  class_name String
  status     ClassStatus @default(DRAFT)
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  school           School?           @relation(fields: [school_id], references: [id], onDelete: SetNull)
  teacher          TeacherProfile?   @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  enrollments      ClassEnrollment[]
  class_courses    ClassCourse[]
  exam_submissions ExamSubmission[]
  sessions         ClassSession[]

  @@index([school_id])
  @@index([teacher_id])
  @@map("classes")
}

model ClassEnrollment {
  id          String   @id @default(uuid())
  class_id    String
  student_id  String
  joined_date DateTime @default(now())

  class   Class          @relation(fields: [class_id], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([class_id])
  @@index([student_id])
  @@map("class_enrollments")
}

model ClassCourse {
  id         String  @id @default(uuid())
  teacher_id String?
  course_id  String
  class_id   String

  teacher TeacherProfile? @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  course  Course          @relation(fields: [course_id], references: [id], onDelete: Cascade)
  class   Class           @relation(fields: [class_id], references: [id], onDelete: Cascade)

  @@index([class_id])
  @@index([course_id])
  @@map("class_courses")
}

model ClassSession {
  id          String   @id @default(uuid())
  class_id    String
  teacher_id  String?
  title       String?
  start_time  DateTime
  end_time    DateTime
  room        String?
  meeting_url String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  class   Class           @relation(fields: [class_id], references: [id], onDelete: Cascade)
  teacher TeacherProfile? @relation(fields: [teacher_id], references: [id], onDelete: SetNull)

  @@index([class_id])
  @@index([teacher_id])
  @@index([start_time])
  @@map("class_sessions")
}

// ----------------------------------------------------
// QUESTIONS & EXAMS
// ----------------------------------------------------

model QuestionBank {
  id         String   @id @default(uuid())
  title      String
  owner_id   String?
  school_id  String?
  is_premium Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  owner            User?            @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  school           School?          @relation(fields: [school_id], references: [id], onDelete: SetNull)
  questions        Question[]
  exam_submissions ExamSubmission[]

  @@index([owner_id])
  @@index([school_id])
  @@map("question_banks")
}

model Question {
  id              String          @id @default(uuid())
  bank_id         String?
  lesson_id       String?
  chapter_id      Int? // Chương SGK
  subject         String? // "toan-hoc", "vat-ly"...
  grade           Int? // Khối 1 - 12
  bloom_level     BloomLevel?     @default(THONG_HIEU)
  question_format QuestionFormat? @default(SINGLE_CHOICE)
  type            QuestionType?   @default(MULTIPLE_CHOICE)
  topic_tag       String? // Chuyên đề / Dạng bài cụ thể (GDPT 2018)
  cognitive_tag   String? // Nhận biết | Thông hiểu | Vận dụng | Vận dụng cao
  trap_tag        String? // Bẫy sai lầm phổ biến (Trap Tag)
  title           String?
  question        String          @db.Text
  answer          String?         @db.Text
  explanation     String?         @db.Text
  default_points  Decimal?        @default(0.25) @db.Decimal(4, 2)
  created_at      DateTime        @default(now())

  bank               QuestionBank?      @relation(fields: [bank_id], references: [id], onDelete: SetNull)
  lesson             Lesson?            @relation(fields: [lesson_id], references: [id], onDelete: SetNull)
  answers            Answer[]
  submission_answers SubmissionAnswer[]

  @@index([bank_id])
  @@index([lesson_id])
  @@index([subject, grade, bloom_level])
  @@index([subject, grade, chapter_id, bloom_level, topic_tag, id])
  @@index([topic_tag])
  @@map("questions")
}

model Answer {
  id          String  @id @default(uuid())
  question_id String
  content     String  @db.Text
  explain     String? @db.Text
  img_url     String? @db.Text
  is_answer   Boolean @default(false)
  sub_label   String? // 'a', 'b', 'c', 'd' (dành cho Đúng/Sai 4 ý con)

  question           Question           @relation(fields: [question_id], references: [id], onDelete: Cascade)
  submission_answers SubmissionAnswer[]

  @@index([question_id])
  @@map("answers")
}

// ----------------------------------------------------
// ACADEMIC TRACKING & EVALUATION
// ----------------------------------------------------

model ExamSubmission {
  id                 String           @id @default(uuid())
  attempt_token      String?          @unique @db.VarChar(64)
  student_id         String
  bank_id            String?
  lesson_id          String?
  class_id           String?
  exam_title         String?          @db.VarChar(255)
  exam_type          String?          @default("STANDARD") // 'STANDARD' | 'OLYMPIAD'
  status             SubmissionStatus @default(IN_PROGRESS)
  score              Decimal?         @db.Decimal(5, 2)
  total_points       Decimal?         @default(10.00) @db.Decimal(5, 2)
  time_spent_seconds Int?             @default(0)
  started_at         DateTime         @default(now())
  submitted_at       DateTime?
  graded_at          DateTime?
  teacher_notes      String?          @db.Text
  snapshot_data      Json? // JSONB: Lưu trọn vẹn toàn bộ bài thi + lời giải để FE mở modal tức thì

  student StudentProfile     @relation(fields: [student_id], references: [id], onDelete: Cascade)
  bank    QuestionBank?      @relation(fields: [bank_id], references: [id], onDelete: SetNull)
  lesson  Lesson?            @relation(fields: [lesson_id], references: [id], onDelete: SetNull)
  class   Class?             @relation(fields: [class_id], references: [id], onDelete: SetNull)
  answers SubmissionAnswer[]

  @@index([student_id])
  @@index([bank_id])
  @@index([lesson_id])
  @@index([class_id])
  @@index([submitted_at])
  @@map("exam_submissions")
}

model SubmissionAnswer {
  id                  String   @id @default(uuid())
  submission_id       String
  question_id         String
  selected_answer_id  String?
  student_text_answer String?  @db.Text // Điền số / Trả lời ngắn / Tự luận
  sub_answers_json    Json? // JSONB: Lưu lựa chọn a: true, b: false... của câu Đúng/Sai 4 ý
  text_answer         String?  @db.Text
  is_correct          Boolean?
  points_earned       Decimal? @db.Decimal(5, 2)
  teacher_feedback    String?  @db.Text

  submission      ExamSubmission @relation(fields: [submission_id], references: [id], onDelete: Cascade)
  question        Question       @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_answer Answer?        @relation(fields: [selected_answer_id], references: [id], onDelete: SetNull)

  @@index([submission_id])
  @@index([question_id])
  @@index([selected_answer_id])
  @@map("submission_answers")
}

model StudentProgress {
  id             String   @id @default(uuid())
  student_id     String
  course_id      String
  lesson_id      String
  completion_pct Int      @default(0)
  last_accessed  DateTime @default(now())
  is_completed   Boolean  @default(false)

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  course  Course         @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lesson  Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([student_id, course_id])
  @@index([student_id])
  @@index([course_id])
  @@map("student_progress")
}

// ----------------------------------------------------
// GAMIFICATION / STORE ITEMS & INVENTORY
// ----------------------------------------------------

model StoreItem {
  id          String         @id @default(uuid())
  teacher_id  String?
  user_id     String?
  type        StoreItemType? @default(OTHER)
  name        String
  description String?
  points      Int            @default(0)
  stock       Int            @default(0)
  image_url   String?
  status      ItemStatus     @default(ACTIVE)
  expired     DateTime?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt

  teacher   TeacherProfile?    @relation(fields: [teacher_id], references: [id], onDelete: SetNull)
  user      User?              @relation(fields: [user_id], references: [id], onDelete: SetNull)
  inventory StudentInventory[]

  @@index([teacher_id])
  @@index([user_id])
  @@map("store_items")
}

model StudentInventory {
  id         String   @id @default(uuid())
  student_id String
  item_id    String
  type       String?
  points     Int      @default(0)
  buy_at     DateTime @default(now())
  active     Boolean  @default(true)

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  item    StoreItem      @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@index([student_id])
  @@index([item_id])
  @@map("student_inventory")
}

// ----------------------------------------------------
// ORDERS & TRANSACTIONS
// ----------------------------------------------------

model Order {
  id                  String             @id @default(uuid())
  user_id             String
  reference_type      OrderReferenceType
  subscription_id     String?
  course_id           String?
  item_name_snapshot  Json?
  item_price_snapshot Decimal            @db.Decimal(10, 2)
  status              OrderStatus        @default(PENDING)
  payment_method      PaymentMethod      @default(BANK)
  seller_id           String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  user         User                 @relation("OrderBuyer", fields: [user_id], references: [id], onDelete: Cascade)
  seller       User?                @relation("OrderSeller", fields: [seller_id], references: [id], onDelete: SetNull)
  subscription SubscriptionPackage? @relation(fields: [subscription_id], references: [id], onDelete: SetNull)
  course       Course?              @relation(fields: [course_id], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([user_id])
  @@index([seller_id])
  @@map("orders")
}

model Transaction {
  id               String          @id @default(uuid())
  order_id         String?
  transaction_type TransactionType
  amount           Decimal         @db.Decimal(10, 2)
  recipient_id     String?
  created_at       DateTime        @default(now())

  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@map("transactions")
}

// ----------------------------------------------------
// NOTIFICATIONS
// ----------------------------------------------------

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@map("notifications")
}

// ----------------------------------------------------
// AI AGENT & SEMANTIC CACHE (Zero-API-Key Architecture)
// ----------------------------------------------------

model SemanticCache {
  id               String   @id @default(uuid())
  query_text       String   @db.Text
  query_vector     Float[] // Vector embedding (1024 dimensions)
  response_text    String   @db.Text
  client_actions   Json? // Array of Client Tool Actions (JSON)
  emotion          String? // Biểu cảm robot (happy, thinking, stunned...)
  suggestions      Json? // Array of string (Dynamic contextual suggestion chips)
  subject          String? // e.g. "toan-hoc", "vat-ly"
  grade            Int? // 10, 11, 12
  hit_count        Int      @default(1)
  ttl_days         Int?     @default(7)
  last_accessed_at DateTime @default(now())
  created_at       DateTime @default(now())

  @@index([subject, grade])
  @@map("semantic_cache")
}

model ChatSession {
  id                 String   @id @default(uuid())
  sessionKey         String   @unique @map("session_key")
  userId             String?  @map("user_id")
  title              String   @default("Cuộc trò chuyện mới")
  isPinned           Boolean  @default(false) @map("is_pinned")
  messageCount       Int      @default(0) @map("message_count")
  lastMessagePreview String?  @map("last_message_preview")
  summaryText        String?  @map("summary_text")
  sessionVector      Json?    @map("session_vector")
  messages           Json     // Mảng tin nhắn ChatMessage[]
  expiresAt          DateTime @map("expires_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([userId, isPinned, updatedAt])
  @@index([sessionKey])
  @@index([expiresAt])
  @@map("chat_sessions")
}

model SemanticCheckpointLog {
  id                String   @id @default(uuid())
  question_id       String?
  student_answer    String   @db.Text
  rubric_checkpoint String   @db.Text
  matched_sentence  String?  @db.Text
  vector_similarity Float?
  is_correct        Boolean
  explanation       String?  @db.Text
  created_at        DateTime @default(now())

  @@index([question_id])
  @@map("semantic_checkpoint_logs")
}

model ExamPointLog {
  id            String   @id @default(uuid())
  student_id    String
  action_type   String   @db.VarChar(50) // DAILY_GRANT | START_EXAM | SCORE_PENALTY_UNDER_5 | SCORE_NEUTRAL | SCORE_REWARD_8_5_TO_9_9 | SCORE_REWARD_10
  exam_level    String?  @db.VarChar(30) // BASIC | MEDIUM | ADVANCED
  exam_title    String?  @db.VarChar(255)
  submission_id String?
  exam_score    Decimal? @db.Decimal(5, 2)
  points_before Float
  points_delta  Float
  points_after  Float

  note       String?  @db.Text
  created_at DateTime @default(now())

  student StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, created_at])
  @@map("exam_point_logs")
}

// ----------------------------------------------------
// STUDENT KNOWLEDGE PROFILING & ADAPTIVE ROADMAP
// ----------------------------------------------------

model StudentTopicMastery {
